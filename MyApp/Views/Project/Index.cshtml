@model List<MyApp.Models.Project>
@using MyApp.Models
@using System.Security.Claims
@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isLoggedIn = User.Identity.IsAuthenticated;
}

<h1>Alla projekt</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100">
        <div id="liveToast" class="toast align-items-center text-white bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

@if (isLoggedIn)
{
    <a asp-action="Add" class="btn btn-secondary my-3">
        Skapa projekt +
    </a>
}

<div class="projects-grid">
    @foreach (var project in Model)
    {
        var isCreator = isLoggedIn && project.Creator?.Id.ToString() == currentUserId;
        var isParticipant = isLoggedIn && project.Participants.Any(p => p.UserId.ToString() == currentUserId);

        <div class="project-card ourBackgroundColor rounded">
            <div class="project-card-header">
                <div>
                    <span class="label"><strong>Titel:</strong></span>
                    <span>@project.Title</span>
                </div>

                @if (isCreator)
                {
                    <a asp-action="Edit" asp-route-id="@project.ProjectId" class="btn btn-light">
                        <i class="bi bi-pencil"></i>
                    </a>
                }
            </div>

            <p><strong>Beskrivning:</strong><br />@project.Description</p>
            <p><strong>Programmeringsspråk:</strong> @project.CodeLanguage</p>

            <p><strong>Deltagare:</strong></p>
            <ul>
                @foreach (var participant in project.Participants)
                {
                    <li>
                        @if (participant.User != null && participant.User.Deactivated)
                        {
                            <span class="text-muted fst-italic">[Avaktiverad användare]</span>
                        }
                        else if (isLoggedIn || (participant.User != null && participant.User.Visibility))
                        {
                            @participant.User?.Name
                        }
                        else
                        {
                            <span class="text-muted"><i>Privat deltagare</i></span>
                        }
                    </li>
                }
            </ul>

            <p>
                <strong>Skapad av:</strong>
                @if (project.Creator != null && project.Creator.Deactivated)
                {
                    <span class="text-muted fst-italic">[Avaktiverad användare]</span>
                }
                else if (isLoggedIn || (project.Creator != null && project.Creator.Visibility))
                {
                    @project.Creator?.Name
                }
                else
                {
                    <span class="text-muted"><i>Privat användare</i></span>
                }
            </p>

            @* Knappar för att gå med eller lämna *@
            @if (isLoggedIn)
            {
                <div class="project-action-wrapper">
                    @if (isParticipant)
                    {
                        @* Alla som är deltagare (inklusive skaparen) ska kunna gå med och ut ur projektet*@
                        <button class="project-leave-btn" type="button" data-bs-toggle="modal" data-bs-target="#leaveModal-@project.ProjectId"> - </button>
                    }
                    else
                    {
                        @**@
                        <button class="project-join-btn" type="button" data-bs-toggle="modal" data-bs-target="#joinModal-@project.ProjectId"> + </button>
                    }
                </div>
            }
        </div> @* Stänger project-card *@

        @* MODAL FÖR ATT GÅ MED *@
        <div class="modal fade" id="joinModal-@project.ProjectId" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Gå med i projekt</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center">
                        <p>Vill du gå med i projektet <strong>@project.Title</strong>?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                        <form method="post" asp-action="JoinProject" asp-route-id="@project.ProjectId">
                            <button type="submit" class="btn btn-success">Ja, gå med!</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        @* MODAL FÖR ATT LÄMNA *@
        <div class="modal fade" id="leaveModal-@project.ProjectId" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Lämna projekt</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center">
                        <p>Vill du verkligen lämna projektet <strong>@project.Title</strong>?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                        <form method="post" asp-action="LeaveProject" asp-route-id="@project.ProjectId">
                            <button type="submit" class="btn btn-danger">Ja, lämna projektet.</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function closeAlert() {
            var alertBox = document.getElementById('liveToast');
            if (alertBox) { alertBox.style.display = 'none'; }
        }
        setTimeout(closeAlert, 5000);
    </script>
}