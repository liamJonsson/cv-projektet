@model List<MyApp.Models.Project>
@using MyApp.Models
@using System.Security.Claims
@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isLoggedIn = User.Identity.IsAuthenticated;
}

<h1>Alla projekt</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100">
        <div id="liveToast" class="toast align-items-center text-white bg-success border-0 @(TempData["SuccessMessage"] != null ? "show" : "hide")" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

@if (isLoggedIn)
@*om användaren är inloggad ska man kunna skapa projekt*@
{
    <a asp-action="Add" class="btn btn-secondary my-3">
        Skapa projekt +
    </a>
}



<div class="projects-grid">

    @*Loopar igenom alla projekt i listan från controllern*@
    @foreach (var project in Model)
    {
        var isCreator = isLoggedIn && project.Creator?.Id.ToString() == currentUserId;
        var isParticipant = isLoggedIn && project.Participants.Any(p => p.UserId.ToString() == currentUserId);

        <div class="project-card ourBackgroundColor rounded">
            <div class="project-card-header">
                <div>
                    <span class="label"><strong>Titel:</strong></span>
                    <span>@project.Title</span>
                </div>

                @if (isCreator)
                {
                    <a asp-action="Edit" asp-route-id="@project.ProjectId" class="btn btn-light">
                        <i class="bi bi-pencil"></i>
                    </a>
                }
            </div>

            <p><strong>Beskrivning:</strong><br />@project.Description</p>
            <p><strong>Programmeringsspråk:</strong> @project.CodeLanguage</p>

            <p><strong>Deltagare:</strong></p>
            <ul>
                @foreach (var participant in project.Participants)
                {
                    <li>
                        @if (isLoggedIn || (participant.User != null && participant.User.Visibility))
                        {
                            @* Visa namnet om man är inloggad ELLER om deltagaren är offentlig *@
                            @participant.User?.Name
                        }
                        else
                        {
                            @* Visa detta om man är utloggad OCH deltagaren är privat *@
                            <span class="text-muted"><i>Privat deltagare</i></span>
                        }
                    </li>
                }
            </ul>

            <p>
                <strong>Skapad av:</strong>
                @if (isLoggedIn || (project.Creator != null && project.Creator.Visibility))
                {
                    @* Visa namnet om man är inloggad ELLER om skaparen är offentlig *@
                    @project.Creator?.Name
                }
                else
                {
                    @* Visa detta endast om man är utloggad OCH skaparen är privat *@
                    <span class="text-muted"><i>Privat användare</i></span>
                }
            </p>

                @if (isLoggedIn)
                {
                    <div class="project-action-wrapper">
                        @if (isParticipant)
                        {
                            <button class="project-leave-btn" type="button" onclick="showLeaveBox('@project.ProjectId')"> - </button>
                        }
                        else
                        {
                            <button class="project-join-btn" type="button" onclick="showJoinBox('@project.ProjectId')"> + </button>
                        }
                    </div>
                }
            </div>

            @* BEKRÄFTELSE-BOXAR *@
            <div id="join-box-@project.ProjectId" class="join-confirm-box" style="display:none;">
                <p>Vill du vara med i projektet?</p>
                <div class="confirm-actions">
                    <form method="post" asp-action="JoinProject" asp-route-id="@project.ProjectId">
                        <button type="submit" class="btn-yes">Ja</button>
                    </form>
                    <button type="button" class="btn-cancel" onclick="hideJoinBox('@project.ProjectId')">Avbryt</button>
                </div>
            </div>

            <div id="leave-box-@project.ProjectId" class="join-confirm-box" style="display:none;">
                <p>Vill du ta bort dig själv från projektet?</p>
                <div class="confirm-actions">
                    <form method="post" asp-action="LeaveProject" asp-route-id="@project.ProjectId">
                        <button type="submit" class="btn-yes">Ja</button>
                    </form>
                    <button type="button" class="btn-cancel" onclick="hideLeaveBox('@project.ProjectId')">Avbryt</button>
                </div>
            </div>
        
    }
</div> @* Stänger projects-grid *@

@section Scripts {
    <script>
        function showJoinBox(projectId) {
            document.querySelectorAll('.join-confirm-box').forEach(box => box.style.display = 'none');
            var box = document.getElementById('join-box-' + projectId);
            if (box) { box.style.display = 'block'; }
        }

        function hideJoinBox(projectId) {
            var box = document.getElementById('join-box-' + projectId);
            if (box) { box.style.display = 'none'; }
        }

        function showLeaveBox(projectId) {
            document.querySelectorAll('.join-confirm-box').forEach(box => box.style.display = 'none');
            var box = document.getElementById('leave-box-' + projectId);
            if (box) { box.style.display = 'block'; }
        }

        function hideLeaveBox(projectId) {
            var box = document.getElementById('leave-box-' + projectId);
            if (box) { box.style.display = 'none'; }
        }

        function closeAlert() {
            var alertBox = document.getElementById('successAlert');
            if (alertBox) { alertBox.style.display = 'none'; }
        }

        setTimeout(function() {
            closeAlert();
        }, 5000);
    </script>
}