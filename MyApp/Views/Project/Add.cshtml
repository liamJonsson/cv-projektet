@model MyApp.Models.Project

<div class="container mt-5" style="max-width: 800px;">
    <h2 class ="text-center mb-5"> Skapa ett projekt</h2>
    
    @* SuccessMessage när man lagt till projekt *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100">
            <div id="liveToast" class="toast align-items-center text-white bg-success border-0 @(TempData["SuccessMessage"] != null ? "show" : "hide")" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    @* Fyller i info om projektet *@
    <form asp-action="Add" method="post">
        
        @* Titel *@
        <div class="row mb-3 align-items-center">
            <label class="col-md-3 col-form-label">Titel</label>
            <div class="col-md-9">
                <input asp-for="Title" class="form-control border-0 ourBackgroundColor" style="height: 45px;" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
        </div>

        @* Beskrivning *@
        <div class="row mb-3 align-items-start">
            <label class="col-md-3 col-form-label">Beskrivning</label>
            <div class="col-md-9">
                <textarea asp-for="Description" class="form-control border-0 ourBackgroundColor" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>

        @* Programmeringsspråk *@
        <div class="row mb-3 align-items-center">
            <label class="col-md-3 col-form-label">Programmeringsspråk</label>
            <div class="col-md-9">
                <input asp-for="CodeLanguage" class="form-control border-0" style="background-color: #dcdcdc; height: 45px;" />
                <span asp-validation-for="CodeLanguage" class="text-danger small"></span>
            </div>
        </div>

        @* Startdatum *@
        <div class="row mb-3 align-items-center">
            <label class="col-md-3 col-form-label">Startdatum</label>
            <div class="col-md-9">
                <input asp-for="StartDate" type="date" class="form-control border-0" style="background-color: #dcdcdc; height: 45px;" onclick="this.showPicker()" />
                <span asp-validation-for="StartDate" class="text-danger small"></span>
            </div>
        </div>

        @* Skapare *@
        <div class="row mb-3 align-items-center">
            <label class="col-md-3 col-form-label">Skapad av:</label>
            <div class="col-md-9">
                <input typeof="text" value="@User.Identity.Name" class="form-control border-0" style="background-color: #dcdcdc; height: 45px;" readonly />
            </div>
        </div>

        @* Spara-knapp *@
        <div class="row mt-5">
            <div class="col-12 text-center">
                <button type="submit" class="btn px-5 py-2" style="background-color: #c0c0c0; border: none; font-size: 1.1rem;">Spara projekt</button>
            </div>
        </div>
    </form>
</div>

@* Realtidsvalidering för programmeringsspråk *@
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {

            var input = $("#CodeLanguage");

            input.on("input", function () {
                $(this).valid(); 
            });
        });
    </script>
}