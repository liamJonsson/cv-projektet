@model MyApp.Models.Project

<div class="container mt-5" style="max-width: 800px;">
    <h2 class="text-center">Redigera projekt</h2>
    <p class="text-muted text-center mb-5">Här kan du ändra detaljerna för ditt projekt.</p>

    <form asp-action="Edit" method="post">
        @* Viktiga dolda fält för att databasen ska veta vad som uppdateras *@
        <input type="hidden" asp-for="ProjectId" />
        <input type="hidden" asp-for="CreatorId" />

        <div class="row mb-3 align-items-center">
            <label class="col-md-3 col-form-label">Titel</label>
            <div class="col-md-9">
                <input asp-for="Title" class="form-control border-0" style="background-color: #dcdcdc; height: 45px;" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
        </div>

        <div class="row mb-3 align-items-start">
            <label class="col-md-3 col-form-label">Beskrivning</label>
            <div class="col-md-9">
                <textarea asp-for="Description" class="form-control border-0" style="background-color: #dcdcdc;" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>

        <div class="row mb-3 align-items-center">
            <label class="col-md-3 col-form-label">Startdatum</label>
            <div class="col-md-9">
                <input asp-for="StartDate" type="date" class="form-control border-0" style="background-color: #dcdcdc; height: 45px;" />
                <span asp-validation-for="StartDate" class="text-danger small"></span>
            </div>
        </div>

        <div class="row mb-3 align-items-center">
            <label class="col-md-3 col-form-label">Programmeringsspråk</label>
            <div class="col-md-9">
                <input asp-for="CodeLanguage" class="form-control border-0" style="background-color: #dcdcdc; height: 45px;" />
                <span asp-validation-for="CodeLanguage" class="text-danger small"></span>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-12 text-center">
                <button type="submit" class="btn px-5 py-2" style="background-color: #c0c0c0; border: none; font-size: 1.1rem;">Spara ändringar</button>
                <a asp-action="Index" class="btn btn-link text-muted ms-3">Avbryt</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            var input = $("#CodeLanguage");
            input.on("input", function () { 
                $(this).valid(); 
            });
        });
    </script>
}