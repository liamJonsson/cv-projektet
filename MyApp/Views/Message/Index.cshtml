@model IEnumerable<MyApp.Models.Message>

<div class="container mt-5">
	<h2 class="text-center mb-5"> Mina meddelanden</h2>

	@if (TempData["SuccessMessage"] != null)
	{
		<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100">
			<div id="liveToast" class="toast align-items-center text-white bg-success border-0 @(TempData["SuccessMessage"] != null ? "show" : "hide")" role="alert" aria-live="assertive" aria-atomic="true">
				<div class="d-flex">
					<div class="toast-body">
						<i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
					</div>
					<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
				</div>
			</div>
		</div>
	}

	@if(Model == null || !Model.Any())
	{
		<div class="text-center text-muted fst-italic">
			<p>Det finns inga meddelanden.</p>
		</div>
	}
	else
	{
		@foreach (var message in Model)
		{
			var fontWeight = "bold";
			var textColor = "black";

			if (message.Read)
			{
					fontWeight = "normal";
					textColor = "gray";
			}

			<div class="mb-4 mx-auto" style="width: 60%;">		
				<h4 style="font-weight: @fontWeight; color: @textColor;"> 
					Från: @message.SenderName
				</h4>
								
				<div class="p-2 rounded d-flex justify-content-between ourBackgroundColor">
					<p class="px-2" style="font-weight: @fontWeight; color: @textColor;"> @message.Text</p>

					<div class="d-flex align-items-center gap-3">
						<form asp-action="UpdateRead" method="post">
							<input type="hidden" name="messageId" value="@message.MessageId"/>

							<button type="submit" class="btn p-0 border-0 d-flex gap-2 btn-link btn btn-link p-0 border-0 d-flex gap-2 text-decoration-none text-reset">
								@if(message.Read)
								{
									<i class="bi bi-check-square-fill"></i>
								}
								else
								{
									<i class="bi bi-square"></i>
								}
								<span style="cursor: pointer; color: @textColor;">Läst</span>
							</button>
						</form>
						@* Delete-knapp *@
						<button type="button" class="btn p-0 border-0 text-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@message.MessageId" title="Ta bort">
							<i class="bi bi-trash-fill fs-5"></i>
						</button>
					</div>
				</div>
				<p style=" color: @textColor;">
					@message.SentAt.ToString("yyyy-MM-dd HH:mm")
				</p>

				@* Delete *@
				<div class="modal fade" id="deleteModal-@message.MessageId" tabindex="-1" aria-hidden="true">
					<div class="modal-dialog modal-dialog-centered">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title">Ta bort meddelande</h5>
								<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
							</div>
							<div class="modal-body text-center">
								<p>Är du säker på att du vill ta bort meddelandet?</p>
								<p class="small text-muted">Det går inte att ångra detta val.</p>
							</div>
							<div class="modal-footer">
								<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>

								<form asp-action="Delete" method="post">
									<input type="hidden" name="messageId" value="@message.MessageId" />
									<button type="submit" class="btn btn-danger">Ja, ta bort.</button>
								</form>
							</div>
						</div>
					</div>
				</div>
			</div>
		}
	}
</div>
