@model IEnumerable<User>

@if (Model != null && Model.Any())
{
	<div class="mt-4">
		<h5>Andra användare som har arbetat med samma programmeringsspråk i projekt:</h5>
	</div>

	<div class="row justify-content-center">
		@foreach (var user in Model)
		{
			<div class="col-md-6">
				<div class="d-flex justify-content-between rounded p-3 mt-4 ourBackgroundColor">
					<h6 class="text-nowrap m-auto">@user.Name,&nbsp;&nbsp;@user.Address?.City </h6>

					<div class="homepageWidth text-end">
						<a asp-controller="User"
							asp-action="ViewProfile"
							asp-route-id="@user.Id"
							class="btn btn-light">
							Se profil
						</a>

					</div>
				</div>
			</div>
		}
	</div>
}
else
{
	<div class="mt-4 fst-italic">
		<p>Hittade inga användare som deltar i projekt med samma programmeringsspråk som denna användare.</p>
	</div>
}
