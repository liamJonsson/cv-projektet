@model MyApp.InputModels.EditProfileViewModel

@{
    ViewData["Title"] = "Redigera Profil";
    var currentProfilePic = string.IsNullOrEmpty(Model.CurrentProfileImage) ? "default.jpg" : Model.CurrentProfileImage;
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100">
        <div id="liveToast" class="toast align-items-center text-white bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}
<div class="container mt-5">
    <h2 class="text-center mb-5">Mina uppgifter</h2>
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="CurrentProfileImage" />
        <input type="hidden" asp-for="CurrentCvImage" />

        <div class="row mb-5">
            <div class="col-12 d-flex flex-column align-items-center mb-4">
                <div class="position-relative editProfilePictureBox">
                    <img id="profileImagePreview" src="~/images/@currentProfilePic" class="rounded-circle shadow-sm profilePictures" alt="Profilbild">
                    <label for="profileImageInput" class="btn btn-secondary btn-sm rounded-circle position-absolute bottom-0 end-0 shadow d-flex align-items-center justify-content-center editProfilePictureLabel">
                        <i class="bi bi-plus-lg text-white"></i>
                    </label>
                    <input asp-for="NewProfileImageFile" id="profileImageInput" class="d-none" accept="image/*" onchange="previewImage(this, 'profileImagePreview')" />
                </div>
                @if (Model.CurrentProfileImage != "default.jpg" && !string.IsNullOrEmpty(Model.CurrentProfileImage))
                {
                    <div class="mt-2">
                        <button type="submit" name="RemoveProfileImage" value="true" class="btn p-0 border-0 text-danger" title="Ta bort bild">
                            <i class="bi bi-trash-fill fs-5"></i>
                        </button>
                    </div>
                }
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 fw-bold">Namn</label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input asp-for="Name" class="form-control border-0 inputGroupStyle" />
                            <span class="input-group-text border-0 text-dark inputGroupStyle"><i class="bi bi-pencil-square"></i></span>
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 fw-bold">Telefonnummer</label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input asp-for="PhoneNumber" class="form-control border-0 inputGroupStyle" />
                            <span class="input-group-text border-0 text-dark inputGroupStyle"><i class="bi bi-pencil-square"></i></span>
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 fw-bold">Mailadress</label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input asp-for="Email" class="form-control border-0 inputGroupStyle" />
                            <span class="input-group-text border-0 text-dark inputGroupStyle"><i class="bi bi-pencil-square"></i></span>
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 fw-bold">Adress</label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input asp-for="HomeAddress" class="form-control border-0 inputGroupStyle" />
                            <span class="input-group-text border-0 text-dark inputGroupStyle"><i class="bi bi-pencil-square"></i></span>
                        </div>
                        <span asp-validation-for="HomeAddress" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 fw-bold">Postnr</label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input asp-for="ZipCode" class="form-control border-0 inputGroupStyle" />
                            <span class="input-group-text border-0 text-dark inputGroupStyle"><i class="bi bi-pencil-square"></i></span>
                        </div>
                        <span asp-validation-for="ZipCode" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 fw-bold">Ort</label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input asp-for="City" class="form-control border-0 inputGroupStyle" />
                            <span class="input-group-text border-0 text-dark inputGroupStyle"><i class="bi bi-pencil-square"></i></span>
                        </div>
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 fw-bold">Användarnamn</label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input asp-for="UserName" class="form-control border-0 inputGroupStyle" />
                            <span class="input-group-text border-0 text-dark inputGroupStyle"><i class="bi bi-pencil-square"></i></span>
                        </div>
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>
                </div>
                <hr class="my-4" />
                <h5 class="mb-3">Byt lösenord</h5>
                <div class="form-group mb-3">
                    <label asp-for="CurrentPassword" class="control-label">Nuvarande lösenord</label>
                    <div class="input-group">
                        <input asp-for="CurrentPassword" class="form-control ourBackgroundColor" type="password" id="currentPass" />
                        <button class="btn btn-outline-secondary ourBackgroundColor" type="button" onclick="togglePassword('currentPass', 'iconCurrent')">
                            <i class="bi bi-eye" id="iconCurrent"></i>
                        </button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="NewPassword" class="control-label">Nytt lösenord</label>
                    <div class="input-group">
                        <input asp-for="NewPassword" class="form-control ourBackgroundColor" type="password" id="newPass" />
                        <button class="btn btn-outline-secondary ourBackgroundColor" type="button" onclick="togglePassword('newPass', 'iconNew')">
                            <i class="bi bi-eye" id="iconNew"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="ConfirmPassword" class="control-label">Bekräfta nytt lösenord</label>
                    <div class="input-group">
                        <input asp-for="ConfirmPassword" class="form-control ourBackgroundColor" type="password" id="confirmPass" />
                        <button class="btn btn-outline-secondary ourBackgroundColor" type="button" onclick="togglePassword('confirmPass', 'iconConfirm')">
                            <i class="bi bi-eye" id="iconConfirm"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <hr class="my-4" />
                <div class="row mb-4 align-items-center">
                    <label class="col-sm-4 fw-bold">Synlighet</label>
                    <div class="col-sm-8">
                        <select asp-for="Visibility" class="form-select border-0 inputGroupStyle">
                            <option value="true">Offentlig</option>
                            <option value="false">Privat</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-8 offset-sm-4 position-relative">
                    <button type="button" class="btn btn-link text-danger text-decoration-underline p-0 small"
                            data-bs-toggle="modal" data-bs-target="#deactivateModal">
                        Avaktivera konto
                    </button>
                </div>
                <button type="submit" class="btn btn-secondary px-4 py-2 mt-3">Spara uppgifter</button>
            </div>
        </div>

        <h3 id="cv-section" class="text-center mt-5 mb-3">Mitt CV</h3>
        <div class="p-4 rounded position-relative ourBackgroundColor">
            <div class="row">
                <div class="col-md-4">
                    <h5 class="fw-bold">Kompetenser</h5>
                    <textarea asp-for="Skills" class="form-control bg-transparent border-0" rows="10" placeholder="Skriv dina kompetenser..."></textarea>
                </div>
                <div class="col-md-4">
                    <h5 class="fw-bold">Utbildning</h5>
                    <textarea asp-for="Education" class="form-control bg-transparent border-0" rows="10" placeholder="Skriv din utbildning..."></textarea>
                </div>
                <div class="col-md-4">
                    <h5 class="fw-bold">Tidigare erfarenhet</h5>
                    <textarea asp-for="Experience" class="form-control bg-transparent border-0" rows="10" placeholder="Skriv din erfarenhet..."></textarea>
                </div>
            </div>

            <div class="mt-4 d-flex flex-column align-items-start">
                <div class="position-relative rounded-circle overflow-visible shadow-sm ourBackgroundColor cvPicture">
                    @{
                        var cvImgToShow = string.IsNullOrEmpty(Model.CurrentCvImage) ? "default.jpg" : Model.CurrentCvImage;
                    }
                    <img id="cvImagePreview" src="~/images/@cvImgToShow" asp-append-version="true" class="rounded-circle profilePictures" />

                    <label for="cvImageInput" class="btn btn-secondary btn-sm rounded-circle position-absolute shadow-sm d-flex align-items-center justify-content-center editProfileCvPictureLabel">
                        <i class="bi bi-plus-lg text-white"></i>
                    </label>

                    <input asp-for="NewCvImageFile" id="cvImageInput" class="d-none" accept="image/*" onchange="previewImage(this, 'cvImagePreview')" />
                </div>
                @if (!string.IsNullOrEmpty(Model.CurrentCvImage) && Model.CurrentCvImage != "default.jpg")
                {
                    <div class="mt-2 ms-1">
                        <button type="submit" name="RemoveCvImage" value="true" class="btn p-0 border-0 text-danger" title="Ta bort bild">
                            <i class="bi bi-trash-fill fs-5"></i>
                        </button>
                    </div>
                }
            </div>
            <div class="text-end mt-3">
                <button type="submit" class="btn btn-secondary btn-sm">Spara uppgifter</button>
            </div>
        </div>

    </form>
    <hr class="my-5" />
        <h3 class="text-center mt-5 mb-4">Mina Projekt</h3>
        <div class="row">
            @if (Model.ParticipatingProjects != null && Model.ParticipatingProjects.Any())
            {
                @foreach (var projUser in Model.ParticipatingProjects)
                {
                    <div class="col-md-6 mb-4">
                        <div class="p-4 rounded h-100 d-flex flex-column justify-content-center align-items-center text-center ourBackgroundColor">
                            <h5 class="fw-bold">@projUser.Project.Title</h5>
                            <p class="small text-muted">@projUser.Project.Description</p>
                            <div class="mt-auto w-100 pt-3 border-top border-secondary">
                                <span class="badge bg-secondary">@projUser.Project.CodeLanguage</span>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted fst-italic">Inga projekt kopplade ännu.</div>
            }
        </div>
    <div class="modal fade" id="deactivateModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Avaktivera konto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <p>Är du säker på att du vill avaktivera ditt konto? Din profil kommer att döljas och du loggas ut.</p>
                    <p class="small text-muted">Du kan aktivera det igen genom att logga in.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                    <form asp-action="DeactivateAccount" method="post">
                        <button type="submit" class="btn btn-danger">Ja, avaktivera.</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>       
        function togglePassword(fieldId, iconId) {
            var field = document.getElementById(fieldId);
            var icon = document.getElementById(iconId);

            if (field.type === "password") {
                field.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                field.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }
        function previewImage(input, imgId) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function(e) {
                    document.getElementById(imgId).src = e.target.result;
                }

                reader.readAsDataURL(input.files[0]);
            }
        }
        $(document).ready(function () {
            // Hämta samtliga input-fält som ska valideras direkt
            var input = $("#Name, #PhoneNumber, #Email, #HomeAddress, #ZipCode, #City, #UserName");

            input.on("input", function () {
                // Körs ASP.NETS inbyggda validering varje gång input-fältet ändras
                $(this).valid();
            });
        });
    </script>
}