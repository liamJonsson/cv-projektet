@model MyApp.InputModels.EditProfileViewModel

@{
    ViewData["Title"] = "Redigera Profil";
    var currentProfilePic = string.IsNullOrEmpty(Model.CurrentProfileImage) ? "default.jpg" : Model.CurrentProfileImage;
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="container mt-5">
    <h2 class="text-center mb-5">Mina uppgifter</h2>
    <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="CurrentProfileImage" />
        <input type="hidden" asp-for="CurrentCvImage" />
        <div class="row mb-5">
            <div class="col-12 d-flex flex-column align-items-center mb-4">
                <div class="position-relative editProfilePictureBox">
                    <img src="~/images/@currentProfilePic" class="rounded-circle shadow-sm profilePictures" alt="Profilbild">
                    <label for="profileImageInput" class="btn btn-secondary btn-sm rounded-circle position-absolute bottom-0 end-0 shadow d-flex align-items-center justify-content-center editProfilePictureLabel">
                        <i class="bi bi-plus-lg text-white"></i>
                    </label>
                    <input asp-for="NewProfileImageFile" id="profileImageInput" class="d-none" accept="image/*" />
                </div>
                @if (Model.CurrentProfileImage != "default.jpg" && !string.IsNullOrEmpty(Model.CurrentProfileImage))
                {
                    <div class="mt-2">
                        <button type="submit" name="RemoveProfileImage" value="true" class="btn p-0 border-0 text-danger" title="Ta bort bild">
                            <i class="bi bi-trash-fill fs-5"></i>
                        </button>
                    </div>
                }
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 fw-bold">Namn</label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input asp-for="Name" class="form-control border-0 inputGroupStyle"/>
                            <span class="input-group-text border-0 text-dark inputGroupStyle"><i class="bi bi-pencil-square"></i></span>
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 fw-bold">Telefonnummer</label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input asp-for="PhoneNumber" class="form-control border-0 inputGroupStyle" />
                            <span class="input-group-text border-0 text-dark inputGroupStyle"><i class="bi bi-pencil-square"></i></span>
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 fw-bold">Mailadress</label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input asp-for="Email" class="form-control border-0 inputGroupStyle" />
                            <span class="input-group-text border-0 text-dark inputGroupStyle"><i class="bi bi-pencil-square"></i></span>
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 fw-bold">Adress</label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input asp-for="HomeAddress" class="form-control border-0 inputGroupStyle" />
                            <span class="input-group-text border-0 text-dark inputGroupStyle"><i class="bi bi-pencil-square"></i></span>
                        </div>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 fw-bold">Användarnamn</label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input asp-for="UserName" class="form-control border-0 inputGroupStyle" />
                            <span class="input-group-text border-0 text-dark inputGroupStyle"><i class="bi bi-pencil-square"></i></span>
                        </div>
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>
                </div>
                <hr class="my-4" />
                <h5 class="mb-3">Byt lösenord</h5>
                <div class="form-group mb-3">
                    <label asp-for="CurrentPassword" class="control-label">Nuvarande lösenord</label>
                    <div class="input-group">
                        <input asp-for="CurrentPassword" class="form-control" type="password" id="currentPass" />
                        <button class="btn btn-outline-secondary ourBackgroundColor" type="button" onclick="togglePassword('currentPass', 'iconCurrent')">
                            <i class="bi bi-eye" id="iconCurrent"></i>
                        </button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="NewPassword" class="control-label">Nytt lösenord</label>
                    <div class="input-group">
                        <input asp-for="NewPassword" class="form-control ourBackgroundColor" type="password" id="newPass" />
                        <button class="btn btn-outline-secondary ourBackgroundColor" type="button" onclick="togglePassword('newPass', 'iconNew')">
                            <i class="bi bi-eye" id="iconNew"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="ConfirmPassword" class="control-label">Bekräfta nytt lösenord</label>
                    <div class="input-group">
                        <input asp-for="ConfirmPassword" class="form-control ourBackgroundColor" type="password" id="confirmPass" />
                        <button class="btn btn-outline-secondary ourBackgroundColor" type="button" onclick="togglePassword('confirmPass', 'iconConfirm')">
                            <i class="bi bi-eye" id="iconConfirm"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <hr class="my-4" />
                <div class="row mb-4 align-items-center">
                    <label class="col-sm-4 fw-bold">Synlighet</label>
                    <div class="col-sm-8">
                        <select asp-for="Visibility" class="form-select border-0 inputGroupStyle">
                            <option value="true">Offentlig</option>
                            <option value="false">Privat</option>
                        </select>  
                    </div>
                </div>
                <div class="col-sm-8 offset-sm-4 position-relative">
                    <button type="button" class="btn btn-link text-danger text-decoration-underline p-0 small"
                            onclick="toggleDeactivateBox()">
                        Avaktivera konto
                    </button>
                    <div id="deactivate-box" class="join-confirm-box shadow" style="display:none; position: absolute; bottom: 100%; left: 0; z-index: 1000; width: 250px; background: white; padding: 15px; border-radius: 5px; border: 1px solid #ddd;">
                        <p class="mb-2 fw-bold text-dark">Är du säker?</p>
                        <p class="small text-muted mb-3" style="line-height: 1.2;">Din profil döljs och du loggas ut.</p>
                        <div class="confirm-actions d-flex gap-2 justify-content-start">
                            <form asp-action="DeactivateAccount" method="post">
                                <button type="submit" class="btn btn-danger btn-sm">Ja</button>
                            </form>

                            <button type="button" class="btn btn-secondary btn-sm" onclick="toggleDeactivateBox()">Nej</button>
                        </div>
                    </div>
                </div>
                <button type="submit" name="submitButton" value="SaveProfile" class="btn btn-secondary px-4 py-2">Spara uppgifter</button>
            </div>
            <div class="col-md-6">
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-3 fw-bold">Postnr</label>
                    <div class="col-sm-3">
                        <div class="input-group">
                            <input asp-for="ZipCode" class="form-control border-0 inputGroupStyle" />
                            <span class="input-group-text border-0 text-dark inputGroupStyle"><i class="bi bi-pencil-square"></i></span>
                        </div>
                    </div>
                    <label class="col-sm-2 text-end fw-bold">Ort</label>
                    <div class="col-sm-4">
                        <div class="input-group">
                            <input asp-for="City" class="form-control border-0 inputGroupStyle" />
                            <span class="input-group-text border-0 text-dark inputGroupStyle"><i class="bi bi-pencil-square"></i></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <h3 class="text-center mt-5 mb-3">Mitt CV</h3>
        <div class="p-4 rounded position-relative ourBackgroundColor">
            <div class="row">
                <div class="col-md-4">
                    <h5 class="fw-bold">Kompetenser</h5>
                    <textarea asp-for="Skills" class="form-control bg-transparent border-0" rows="10" placeholder="Skriv dina kompetenser..."></textarea>
                </div>
                <div class="col-md-4">
                    <h5 class="fw-bold">Utbildning</h5>
                    <textarea asp-for="Education" class="form-control bg-transparent border-0" rows="10" placeholder="Skriv din utbildning..."></textarea>
                </div>
                <div class="col-md-4">
                    <h5 class="fw-bold">Tidigare erfarenhet</h5>
                    <textarea asp-for="Experience" class="form-control bg-transparent border-0" rows="10" placeholder="Skriv din erfarenhet..."></textarea>
                </div>
            </div>
            <div class="mt-4 d-flex flex-column align-items-start">
                <div class="position-relative rounded-circle overflow-visible shadow-sm ourBackgroundColor cvPicture">
                    @{
                        var cvImgToShow = string.IsNullOrEmpty(Model.CurrentCvImage) ? "default.jpg" : Model.CurrentCvImage;
                    }
                    <img src="~/images/@cvImgToShow" asp-append-version="true" class="rounded-circle profilePictures" />
                    <label for="cvImageInput" class="btn btn-secondary btn-sm rounded-circle position-absolute shadow-sm d-flex align-items-center justify-content-center editProfileCvPictureLabel">
                        <i class="bi bi-plus-lg text-white"></i>
                    </label>
                    <input asp-for="NewCvImageFile" id="cvImageInput" class="d-none" accept="image/*" />
                </div>
                @if (!string.IsNullOrEmpty(Model.CurrentCvImage) && Model.CurrentCvImage != "default.jpg")
                {
                    <div class="mt-2 ms-1">
                        <button type="submit" name="RemoveCvImage" value="true" class="btn p-0 border-0 text-danger" title="Ta bort bild">
                            <i class="bi bi-trash-fill fs-5"></i>
                        </button>
                    </div>
                }
            </div>
            <div class="text-end mt-3">
                <button type="submit" name="submitButton" value="SaveCv" class="btn btn-secondary btn-sm">Spara uppgifter</button>
            </div>
        </div>
        </form>
            <hr class="my-5" />
            <h3 class="mb-3">Mina Projekt</h3>
            @if (Model.ParticipatingProjects != null && Model.ParticipatingProjects.Any())
            {
                <ul class="list-group mb-5 w-75">
                    @foreach (var proj in Model.ParticipatingProjects)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center position-relative" style="background-color: #f8f9fa;">
                            <span class="fw-bold">@proj.Project.Title</span>

                            <button type="button" class="btn btn-link text-danger text-decoration-none p-0"
                                    onclick="showLeaveBox('@proj.ProjectId')"
                                    title="Lämna projekt">
                                <i class="bi bi-dash" style="font-size: 1.5rem;"></i>
                            </button>
                            <div id="leave-box-@proj.ProjectId" class="join-confirm-box" style="display:none; position: absolute; right: 0; top: 100%; z-index: 100;">
                                <p class="mb-2">Vill du ta bort dig själv från projektet?</p>
                                <div class="confirm-actions d-flex gap-2 justify-content-center">
                                <form method="post" asp-controller="User" asp-action="LeaveProject" asp-route-projectId="@proj.ProjectId">
                                <button type="submit" class="btn btn-success btn-sm">Ja</button>
                                </form>
                                    <button type="button" class="btn btn-secondary btn-sm" onclick="hideLeaveBox('@proj.ProjectId')">Avbryt</button>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted mb-5">Du är inte med i några projekt än.</p>
            }

        </div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
                function toggleDeactivateBox() {
            var box = document.getElementById('deactivate-box');
            if (box.style.display === 'none') {
                box.style.display = 'block';
            } else {
                box.style.display = 'none';
            }
            }
        function showLeaveBox(projectId) {
            document.querySelectorAll('.join-confirm-box').forEach(box => box.style.display = 'none');           
            var box = document.getElementById('leave-box-' + projectId);
            if (box) { box.style.display = 'block'; }
        }

        function hideLeaveBox(projectId) {
            var box = document.getElementById('leave-box-' + projectId);
            if (box) { box.style.display = 'none'; }
        }
        function togglePassword(fieldId, iconId) {
            var field = document.getElementById(fieldId);
            var icon = document.getElementById(iconId);

            if (field.type === "password") {
                field.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                field.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }
    </script>
}