@using Microsoft.AspNetCore.Identity
@using MyApp.Models
@inject UserManager<User> UserManager
@model MyApp.Models.User

@{
    var loggedInId = UserManager.GetUserId(User);
    var isOwner = loggedInId == Model.Id.ToString();
    ViewData["Title"] = isOwner ? "Min Profil" : Model.Name;
}
<div class="container mt-5">
    @if (isOwner)
    {
        <div class="">
            <i class="bi bi-eye"></i>
            <span>@Model.ProfileViews</span>
        </div>
    }
    <div class="d-flex justify-content-center align-items-center mb-4 position-relative">
        @if (isOwner)
        {
            <a asp-action="EditProfile" class="btn btn-outline-secondary btn-sm position-absolute end-0">
                <i class="bi bi-pencil"></i> Redigera
            </a>
        }
        <h2>@(isOwner ? "Mina Uppgifter" : "Profil")</h2>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3 row">
                <label class="col-sm-4 fw-bold">Namn</label>
                <div class="col-sm-8 py-2 rounded ourBackgroundColor">@Model.Name</div>
            </div>
            <div class="mb-3 row">
                <label class="col-sm-4 fw-bold">Telefonnummer</label>
                <div class="col-sm-8 py-2 rounded ourBackgroundColor">@Model.PhoneNumber</div>
            </div>
            <div class="mb-3 row">
                <label class="col-sm-4 fw-bold">Mailadress</label>
                <div class="col-sm-8 py-2 rounded ourBackgroundColor">@Model.Email</div>
            </div>
            <div class="mb-3 row">
                <label class="col-sm-4 fw-bold">Adress</label>
                <div class="col-sm-8 py-2 rounded ourBackgroundColor">@Model.Address?.HomeAddress</div>
            </div>
            <div class="mb-3 row">
                <label class="col-sm-4 fw-bold">Postnummer</label>
                <div class="col-sm-8 py-2 rounded ourBackgroundColor">@Model.Address?.ZipCode</div>
            </div>
            <div class="mb-3 row">
                <label class="col-sm-4 fw-bold">Ort</label>
                <div class="col-sm-8 py-2 rounded ourBackgroundColor">@Model.Address?.City</div>
            </div>
        </div>
        <div class="col-md-6 d-flex justify-content-center align-items-start">
            <div class="rounded shadow-sm profilePicture">
                @{
                    var profilePicName = string.IsNullOrEmpty(Model.ProfileImage) ? "default.jpg" : Model.ProfileImage;
                }
                <img src="~/images/@profilePicName" class="profilePictures" alt="Profilbild" />
            </div>
        </div>
    </div>
    <h3 class="text-center mt-5 mb-4">CV</h3>
    <div class="p-4 rounded ourBackgroundColor">
        <div class="row">
            <div class="col-md-4 d-flex flex-column mb-3">
                <div>
                    <h5 class="fw-bold">Kompetenser</h5>
                    <p class="text-break cvInformation">
                        @(Model.Skills ?? "Inga kompetenser angivna.")</p>
                </div>
                <div class="mt-auto pt-3">
                    <div class="rounded-circle overflow-hidden shadow-sm ourBackgroundColor cvPicture">
                        @{
                            var imageToShow = string.IsNullOrEmpty(Model.CvImage) ? "default.jpg" : Model.CvImage;
                        }
                        <img src="~/images/@imageToShow" class="profilePictures" alt="CV Bild" />
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <h5 class="fw-bold">Utbildning</h5>
                <p class="text-break cvInformation">
                    @(Model.Education ?? "Ingen utbildning angiven.")</p>
            </div>

            <div class="col-md-4 mb-5">
                <h5 class="fw-bold">Tidigare erfarenhet</h5>
                <p class="text-break cvInformation">
                    @(Model.Experience ?? "Ingen erfarenhet angiven.")</p>
            </div>
        </div>
    </div>
    @*   En div som innehåller knappen "Hitta liknande användare" och diven som som visar matchande användare *@
    <div class="d-flex justify-content-center mt-5">
        <button id="btnFindSimilarUsers" class="btn btn-secondary px-5 py-3" onclick="loadSimilarUsers()">
            <i class="bi-people-fill"></i> Hitta liknande användare
        </button>
        @* En div där liknande användare kommer synas *@
        <div id="similarUsers"></div>
    </div>
    <h3 class="text-center mt-5 mb-4">Projekt</h3>
    <div class="row">
        @if (Model.ParticipatingProjects != null && Model.ParticipatingProjects.Any())
        {
            @foreach (var projUser in Model.ParticipatingProjects)
            {
                <div class="col-md-6 mb-4">
                    <div class="p-4 rounded h-100 d-flex flex-column justify-content-center align-items-center text-center ourBackgroundColor">
                        <h5 class="fw-bold">@projUser.Project.Title</h5>
                        <p class="small text-muted">@projUser.Project.Description</p>
                        <div class="mt-auto w-100 pt-3 border-top border-secondary">
                            <span class="badge bg-secondary">@projUser.Project.CodeLanguage</span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted fst-italic">Inga projekt kopplade ännu.</div>
        }
    </div>
    @if (isOwner)
    {
            <div class="col-12 text-center mt-4">
                <a asp-controller="Project" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-search"></i> Hitta och lägg till projekt
                </a>
            </div>
    }
    @if (!isOwner)
    {
        <div class="row mt-5 justify-content-center">
            <div id="message-section" class="col-md-8">
                <h3 class="text-center mb-4">Skicka meddelande</h3>
                @if (TempData["Sent"] != null)
                {
                    <div class="row mb-3 mt-3">
                        <div class="col-12">
                            <div class="alert alert-success alert-dismissible show text-center border-0 mx-auto sucess-message" role="alert">
                                @TempData["Sent"]
                                <button type="button" class="btn-close close-button" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        </div>
                    </div>
                }
                <form asp-controller="Message" asp-action="Send" method="post">
                    <input type="hidden" name="ReceiverId" value="@Model.Id" />
                    @if (User.Identity.IsAuthenticated)
                    {
                        <input type="hidden" name="SenderId" value="@((ViewBag.LoggedInUser as User)?.Id)" />
                    }
                    <div class="mb-3">
                        <label>Från</label>
                        <input type="text" name="SenderName" class="form-control border-0 ourBackgroundColor"
                               value="@(User.Identity.IsAuthenticated ? ((ViewBag.LoggedInUser as User)?.Name) : "")"
                               @Html.Raw(User.Identity.IsAuthenticated ? "readonly=\"readonly\"" : "placeholder=\"Skriv ditt namn här...\"")
                                                      data-val="true" data-val-required="Namn krävs" />
                        <span class="text-danger" data-valmsg-for="SenderName" data-valmsg-replace="true"></span>
                    </div>
                    <div class="mb-3">
                        <label>Meddelande</label>
                        <textarea name="Text" class="form-control border-0 ourBackgroundColor" rows="5" 
                        placeholder="Skriv ditt meddelande här..."
                        data-val="true" data-val-required="Meddelande får inte vara tomt"></textarea>
                        <span class="text-danger" data-valmsg-for="Text" data-valmsg-replace="true"></span>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-secondary">Skicka</button>
                    </div>
                </form>
            </div>
        </div>
    }
    <div class="mt-5 mb-5 text-center">
        <form asp-controller="User" asp-action="ExportProfile" method="get">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-secondary px-4 py-2">
                <i class="bi bi-file-earmark-code"></i> Exportera profil
            </button>
        </form>
    </div>
</div>
@section Scripts {
    @*Gör att skicka-meddelanden formulärets felmeddelanden visas direkt 
    utan att sidan laddas om, om användaren inte fyllt i det som måste vara ifyllt *@
    <partial name="_ValidationScriptsPartial" />

    <script>
        //Denna funktion körs när man klickar på "Hitta liknande användare" kanppen
        function loadSimilarUsers() {
            //Diven med id "similarUsers" laddas med HTMLkod från vår partial view(_SimilarUsers.cshtml)
            //genom att anoropa FindSimilarUsers i UserControllern. Detta gör att innehållet syns direkt på sidan
            //utan att hela webbläsaren behöver laddas om tack vare AJAX (.load)
            $("#similarUsers").load("/User/FindSimilarUsers?id=@Model.Id")
        }
    </script>
}